<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The stub server hosts Kestrel, so the test assembly needs the ASP.NET Core shared framework. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.AspNetCore.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- One stub HTTP server for every adapter test project: linked, not copied. -->
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\StubHttpServer.cs" Link="Fixtures\StubHttpServer.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\StubReply.cs" Link="Fixtures\StubReply.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\RecordedCall.cs" Link="Fixtures\RecordedCall.cs" />
    <Compile Include="..\Innovayse.Hostpanel.Integration.Tests\Fixtures\RedirectToStubHandler.cs" Link="Fixtures\RedirectToStubHandler.cs" />
    <ProjectReference Include="..\..\src\Innovayse.Providers.Inecobank\Innovayse.Providers.Inecobank.csproj" />
  </ItemGroup>
</Project>
