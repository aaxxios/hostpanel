{
    "name": "hostpanel/migration-addon",
    "description": "Development and test setup of the migration addon for the source billing system. Only modules/ is installed; this file, tests/ and vendor/ stay out of the packaged addon.",
    "type": "project",
    "license": "AGPL-3.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "illuminate/database": "^10.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "HostpanelMigration\\": "modules/addons/innovayse_migration/lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HostpanelMigration\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
