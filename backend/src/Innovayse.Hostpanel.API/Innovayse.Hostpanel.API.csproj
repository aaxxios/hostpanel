<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Settings inherited from Directory.Build.props -->
    <EnableDefaultResourceItems>false</EnableDefaultResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <!--
      AddValidatorsFromAssemblyContaining moved to Innovayse.Hostpanel.Application/DependencyInjection.cs
      (Program.cs split, A6 Task 7B), so the DependencyInjectionExtensions package moved with it —
      see that project's csproj. FluentValidation.AspNetCore stood here once and was never used;
      see Directory.Packages.props for why it could not stay.
    -->
    <PackageReference Include="Mapster" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore.Annotations" />
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Transitive security pin, see Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Build.Tasks.Core">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Innovayse.Hostpanel.Application\Innovayse.Hostpanel.Application.csproj" />
    <ProjectReference Include="..\Innovayse.Hostpanel.Infrastructure\Innovayse.Hostpanel.Infrastructure.csproj" />
    <ProjectReference Include="..\Innovayse.SDK\Innovayse.SDK.csproj" />
    <!-- BaseApiController, StatusMapping, the edge middleware and extensions the API host wires up. -->
    <ProjectReference Include="..\Shared\Innovayse.Hostpanel.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(InnovayseSso)' == 'true'">
    <!--
      Cookie sessions for the admin SPA, in sso mode. Bearer auth stays alongside it:
      the client portal calls this API server-to-server, and standalone deployments
      keep their local JWTs — this package adds a scheme, it does not replace one.
      Only referenced in an SSO build; see InnovayseSso in backend/Directory.Build.props.
    -->
    <PackageReference Include="Innovayse.Auth" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The file sink writes into logs/ next to this project, which is inside the tree
      `dotnet watch` polls. Every log line then looked like a source change: watch
      announced "File updated", and on this bind mount the enumeration eventually threw
      (`An item with the same key has already been added`) and took the API down with it.
      A service that logs cannot be a service that restarts itself.
    -->
    <Watch Remove="logs/**/*" />

    <!--
      And out of the build. The Web SDK includes **/* as Content by default, so without
      this the log files are copied to the output directory and into a publish — a
      release carrying yesterday's development logs.
    -->
    <Content Remove="logs/**/*" />
    <None Remove="logs/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The migration plugin for the source billing system, served by the admin download
      (MigrationPluginArchive, MigrationPlugin:Path). Only its installable modules/ folder
      is copied, into migration-plugin/ beside the binaries, on build and on publish, so the
      same default finds it on a developer machine, in the tests and in the published image.
      Never under plugins/: PluginLoader scans that folder for .NET plugins.
    -->
    <None Include="..\..\plugins\innovayse_migration\modules\**\*"
          LinkBase="migration-plugin\modules"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Build-order-only reference: the API must never link against a plugin assembly
      (PluginLoader loads it reflectively from plugins/ at runtime), but the plugin
      still needs to be built before the staging targets below copy its output.
      Only Innovayse.Providers.Inecobank is staged here — the CWP providers are
      deliberately left unstaged so they don't silently activate at runtime.
    -->
    <ProjectReference Include="..\Innovayse.Providers.Inecobank\Innovayse.Providers.Inecobank.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    Stage the Inecobank payment plugin into plugins/inecobank/ under the
    API's own output, which is where PluginLoader.DiscoverAndRegister scans from
    (AppContext.BaseDirectory/plugins). The provider targets net8.0 while the API
    targets net9.0, so the copy source path is pinned to the provider's own TFM.

    Only the provider's own assembly and its plugin.json manifest are staged — never
    a `**\*.*` glob over the provider's bin folder. That folder also holds a build-time
    copy of Innovayse.SDK.dll/.pdb/.xml (an intra-solution project reference, not
    something the plugin ships), and PluginLoader does Assembly.LoadFrom over every
    DLL it finds in a plugin's folder. A stale staged SDK copy there would load as a
    second, distinct SDK assembly alongside the one the API host already has loaded,
    and every `(IPaymentPlugin)` cast in PaymentPluginResolver would then fail, because
    the plugin's IPaymentPlugin and the host's IPaymentPlugin would be two different
    CLR types with the same name.
  -->
  <Target Name="StagePaymentPlugins" AfterTargets="Build">
    <ItemGroup>
      <InecobankPluginFiles Include="..\Innovayse.Providers.Inecobank\bin\$(Configuration)\net8.0\Innovayse.Providers.Inecobank.dll;..\Innovayse.Providers.Inecobank\bin\$(Configuration)\net8.0\plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(InecobankPluginFiles)"
          DestinationFolder="$(OutDir)plugins\inecobank\"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="StagePaymentPluginsOnPublish" AfterTargets="Publish">
    <ItemGroup>
      <InecobankPluginPublishFiles Include="..\Innovayse.Providers.Inecobank\bin\$(Configuration)\net8.0\Innovayse.Providers.Inecobank.dll;..\Innovayse.Providers.Inecobank\bin\$(Configuration)\net8.0\plugin.json" />
    </ItemGroup>
    <Copy SourceFiles="@(InecobankPluginPublishFiles)"
          DestinationFolder="$(PublishDir)plugins\inecobank\"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
