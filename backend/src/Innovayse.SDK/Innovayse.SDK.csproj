<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>Innovayse.SDK</RootNamespace>

    <!-- Package identity. The version is the contract: bump the minor for an added member,
         the major for a removed or renamed one; sdk:publish in .gitlab-ci.yml pushes a
         version the feed does not have yet and skips one it does. -->
    <PackageId>Innovayse.SDK</PackageId>
    <Version>1.1.0</Version>
    <Authors>Innovayse</Authors>
    <Description>Plugin contracts for hostpanel: provisioning, payment, registrar, identity, fulfilment and hosted plugins.</Description>
    <PackageLicenseExpression>BUSL-1.1</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/innovayse/hostpanel</PackageProjectUrl>
    <RepositoryUrl>https://github.com/innovayse/hostpanel</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
