# Never name the proxy or its version in a response.
server_tokens off;

upstream api_backend {
    server hostpanel-api:${API_PORT};
}

upstream client_frontend {
    server hostpanel-client:3000;
}

upstream admin_frontend {
    server hostpanel-admin:80;
}

# TLS ends at the edge, so $scheme is always http here; forward the edge's X-Forwarded-Proto or the API
# refuses sign-in (__Host- cookies need a secure origin).
map $http_x_forwarded_proto $panel_forwarded_proto {
    ""      $scheme;
    default $http_x_forwarded_proto;
}

# Main site — client + API
server {
    listen 80;
    server_name ${DOMAIN};

    client_max_body_size 50m;

    # API requests
    location /api/ {
        proxy_pass         http://api_backend/api/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }

    # Operator-uploaded branding: the logo, the favicon and the icon set generated from
    # them. Served here on BOTH origins on purpose. The setting rows store root-relative
    # URLs so a domain change never strands them, which only holds if the same path means
    # the same file wherever it is read -- the storefront renders it, and the admin panel
    # previews it straight after the upload.
    location /uploads/ {
        proxy_pass         http://api_backend/uploads/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;

        # These are files an admin uploaded. They are re-encoded to PNG by the API before
        # they are ever written, but nosniff is the second lock: it stops a browser
        # deciding for itself that a stored file is something executable.
        add_header X-Content-Type-Options nosniff always;
    }

    # Scalar API docs
    location /scalar/ {
        proxy_pass         http://api_backend/scalar/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
    }

    # Everything else — Nuxt SSR
    location / {
        proxy_pass         http://client_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
        proxy_set_header   Upgrade $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }
}

# Admin panel
server {
    listen 80;
    server_name ${ADMIN_DOMAIN};

    # Operator-uploaded branding: the logo, the favicon and the icon set generated from
    # them. Served here on BOTH origins on purpose. The setting rows store root-relative
    # URLs so a domain change never strands them, which only holds if the same path means
    # the same file wherever it is read -- the storefront renders it, and the admin panel
    # previews it straight after the upload.
    location /uploads/ {
        proxy_pass         http://api_backend/uploads/;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;

        # These are files an admin uploaded. They are re-encoded to PNG by the API before
        # they are ever written, but nosniff is the second lock: it stops a browser
        # deciding for itself that a stored file is something executable.
        add_header X-Content-Type-Options nosniff always;
    }

    location / {
        proxy_pass         http://admin_frontend;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $panel_forwarded_proto;
    }
}
