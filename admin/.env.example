# Admin SPA (Vite): every environment key admin/ reads. Used by `npm run dev` run directly in admin/;
# the compose stacks pass the same values from docker/.env.
# Copy to .env.local. Placeholders only: no defaults and no real secrets in this file.

# Dev server only: the base is relative (vite.config.ts). A deployed image takes the base path from
# ADMIN_BASE_URL_PATH at container start (docker/.env), never from a build arg.

# Where the dev server proxies /api, e.g. http://hostpanel-api:5148 (vite.config.ts server.proxy).
API_PROXY_TARGET=
