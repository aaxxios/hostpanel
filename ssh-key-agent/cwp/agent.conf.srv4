# /etc/hostpanel-ssh-key-agent/agent.conf for a CWP server with Jailkit customer SSH (srv4 layout).
# Copy per server; nothing here names a host.
[agent]
min_uid = 1000
home_root = /home
deny_accounts = root,admin,nobody,mysql,postfix,dovecot,named,apache,nginx,hpsshkeys
max_keys = 10
audit_log = /var/log/hostpanel-ssh-key-agent.log
lock_dir = /run/hostpanel-ssh-key-agent
# Only members of the jailed-shell group may receive keys (sshd-cust: AllowGroups sftp-ssh ...).
ssh_group = sftp-ssh
# Opt-in list shared with /usr/local/sbin/manage-ssh-key.sh: SSH is never on by default.
eligible_list = /usr/local/etc/innovayse-ssh-eligible.conf
# The account must exist in CWP itself, not only in passwd.
account_check_command = /usr/local/libexec/hostpanel-ssh-key-agent/cwp-account-check
# CWP suspends with `usermod -L`; a locked account cannot receive keys.
check_shadow_lock = true
