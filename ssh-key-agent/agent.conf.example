# /etc/hostpanel-ssh-key-agent/agent.conf
[agent]
# Accounts below this uid are never touched (system users, root).
min_uid = 1000
# Every eligible account's home must be directly under this directory (CWP: /home/<user>).
home_root = /home
# Never managed, whatever their uid.
deny_accounts = root,admin,nobody,mysql,postfix,dovecot,named,apache,nginx
# Hard ceiling of HostPanel-managed keys per account (HostPanel enforces its own, lower limit).
max_keys = 50
audit_log = /var/log/hostpanel-ssh-key-agent.log
lock_dir = /run/hostpanel-ssh-key-agent
